{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "servers": {
      "rea": {
        "type": "local",
        "command": [
          "cmd.exe",
          "/d",
          "/c",
          "npx",
          "-y",
          "rea-agents@6.5.0",
          "mcp"
        ],
        "environment": {
          "REA_GHIDRA_STARTUP_TIMEOUT_MS": "180000",
          "REA_HOPPER_STARTUP_TIMEOUT_MS": "180000"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 120000,
          "execution": 120000
        }
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ]
      }
    }
  }
}
